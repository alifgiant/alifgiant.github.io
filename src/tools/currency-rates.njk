---
layout: layouts/base.njk
title: Currency Rates Tracker
description: Track and compare currency exchange rates with a customizable base currency and amount.
permalink: /tools/currency-rates/
---

<div class="w-full max-w-5xl flex flex-col gap-12" x-data="currencyRatesTool()" x-init="init()">
    {% set tool = {} %}
    {% for item in site.pages.tools.list %}
        {% if item.url == "/tools/currency-rates/" %}
            {% set tool = item %}
        {% endif %}
    {% endfor %}
    {% set cat = site.pages.tools.categories[tool.tag] %}

    <div class="flex flex-col gap-4 text-center items-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border {{ cat.color }}">
            <span class="material-symbols-outlined text-sm">{{ cat.icon }}</span>
            {{ tool.tag }}
        </div>
        <div class="w-16 h-16 rounded-2xl {{ cat.lightColor }} flex items-center justify-center mb-2">
            <span class="material-symbols-outlined text-4xl">{{ tool.icon }}</span>
        </div>
        <h1 class="text-4xl md:text-6xl font-bold text-text-main font-display">
            {{ tool.title }}
        </h1>
        <p class="text-lg text-text-muted max-w-2xl leading-relaxed">
            {{ tool.description }}
        </p>
    </div>

    <div class="bg-white/80 backdrop-blur-md border border-white rounded-[2.5rem] p-8 md:p-12 shadow-2xl shadow-primary/10 transition-all duration-500">
        <div class="flex flex-col gap-8">

            <!-- Source info + Refetch button -->
            <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                <div class="flex flex-col gap-1 text-sm text-text-muted">
                    <div class="font-semibold text-text-main">Source: Frankfurter API</div>
                    <div x-text="lastFetchedLabel()"></div>
                </div>
                <button
                    @click="refetchRates()"
                    :disabled="isLoading || !canRefetch()"
                    class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-2xl bg-primary text-white font-bold hover:bg-primary-dark disabled:opacity-50 disabled:cursor-not-allowed transition-colors shadow-lg shadow-primary/20"
                >
                    <span class="material-symbols-outlined text-base" x-text="isLoading ? 'progress_activity' : 'refresh'"></span>
                    <span x-text="isLoading ? 'Fetching...' : 'Refetch rates'"></span>
                </button>
            </div>

            <template x-if="!canRefetch() && !isLoading">
                <div class="rounded-2xl border border-amber-200 bg-amber-50 text-amber-800 px-4 py-3 text-sm">
                    You can refetch in <span class="font-semibold tabular-nums" x-text="remainingRefetchSeconds()"></span>s.
                </div>
            </template>

            <template x-if="errorMessage">
                <div class="rounded-2xl border border-rose-200 bg-rose-50 text-rose-700 px-4 py-3 text-sm" x-text="errorMessage"></div>
            </template>

            <!-- Tracked currencies section -->
            <div class="flex flex-col gap-5">
                <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
                    <div>
                        <h3 class="text-xl md:text-2xl font-bold text-text-main">Tracked Currency Pairs</h3>
                        <p class="text-sm text-text-muted">Save a base and target currency pair. Each card shows latest rate and a 14-day trend line.</p>
                    </div>
                    <span class="text-xs font-bold uppercase tracking-widest text-text-muted" x-text="trackedPairs.length + ' tracked'"></span>
                </div>

                <!-- Add pair -->
                <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] gap-4 md:items-end">
                    <div class="flex flex-col gap-3">
                        <label class="text-xs font-bold uppercase tracking-widest text-text-muted ml-1">Base Currency</label>
                        <select
                            x-model="pairFormBase"
                            @change="onPairFormBaseChange()"
                            :disabled="isCurrenciesLoading"
                            class="block w-full px-6 py-4 bg-stone-50 border-2 border-stone-100 rounded-2xl text-text-main focus:outline-none focus:border-primary/30 focus:bg-white transition-all text-lg shadow-inner disabled:opacity-50"
                        >
                            <template x-for="currency in allCurrencies()" :key="currency.code">
                                <option :value="currency.code" x-text="`${currency.code} – ${currency.name}`"></option>
                            </template>
                        </select>
                    </div>
                    <div class="flex flex-col gap-3">
                        <label class="text-xs font-bold uppercase tracking-widest text-text-muted ml-1">Target Currency</label>
                        <select
                            x-model="pairFormTarget"
                            :disabled="isCurrenciesLoading"
                            class="block w-full px-6 py-4 bg-stone-50 border-2 border-stone-100 rounded-2xl text-text-main focus:outline-none focus:border-primary/30 focus:bg-white transition-all text-lg shadow-inner disabled:opacity-50"
                        >
                            <template x-for="currency in allCurrencies()" :key="currency.code">
                                <option :value="currency.code" x-text="`${currency.code} – ${currency.name}`"></option>
                            </template>
                        </select>
                    </div>
                    <button
                        @click="addTrackedPair()"
                        :disabled="!canAddPair() || isLoading"
                        class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-2xl bg-primary text-white font-bold hover:bg-primary-dark disabled:opacity-50 disabled:cursor-not-allowed transition-colors shadow-lg shadow-primary/20"
                    >
                        <span class="material-symbols-outlined text-base">add</span>
                        Add pair
                    </button>
                </div>

                <template x-if="trackedPairs.length">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <template x-for="pair in trackedPairs" :key="pairKey(pair.base, pair.target)">
                            <div class="rounded-[2rem] border border-stone-200 bg-stone-50/80 p-6 md:p-7 shadow-sm flex flex-col gap-4">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex flex-col gap-1 min-w-0">
                                        <span class="text-xs font-bold uppercase tracking-widest text-text-muted">Pair</span>
                                        <h3 class="text-2xl font-bold text-text-main leading-tight tabular-nums" x-text="`${pair.base} → ${pair.target}`"></h3>
                                        <span class="text-sm text-text-muted" x-text="`${availableCurrencies[pair.base] || ''} to ${availableCurrencies[pair.target] || ''}`"></span>
                                    </div>
                                    <button
                                        @click="removeTrackedPair(pair)"
                                        class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-white text-text-muted hover:text-rose-600 hover:bg-rose-50 border border-stone-200 transition-colors flex-shrink-0"
                                        aria-label="Remove tracked pair"
                                    >
                                        <span class="material-symbols-outlined text-base">delete</span>
                                    </button>
                                </div>

                                <template x-if="hasPairLatestRate(pair)">
                                    <div class="flex flex-col gap-1">
                                        <span class="text-4xl font-bold text-text-main leading-none tabular-nums" x-text="formatRate(pairLatestRate(pair))"></span>
                                        <span class="text-sm text-text-muted" x-text="`1 ${pair.base} = ${formatRate(pairLatestRate(pair))} ${pair.target}`"></span>
                                    </div>
                                </template>

                                <template x-if="!hasPairLatestRate(pair)">
                                    <div class="rounded-2xl border border-dashed border-stone-300 bg-white/80 px-4 py-5 text-sm text-text-muted">
                                        Latest rate unavailable. Use Refetch to load.
                                    </div>
                                </template>

                                <template x-if="pairHistoryRates(pair).length >= 2">
                                    <div class="rounded-2xl border border-stone-200 bg-white p-4">
                                        <div class="flex items-center justify-between text-xs font-bold uppercase tracking-wider mb-3">
                                            <span :class="pairIsUpward(pair) ? 'text-emerald-600' : 'text-rose-600'" x-text="pairIsUpward(pair) ? 'Upward trend' : 'Downward trend'"></span>
                                            <span class="text-text-muted">Last 14 days</span>
                                        </div>
                                        <svg viewBox="0 0 320 100" class="w-full h-24">
                                            <path
                                                :d="pairChartPath(pair)"
                                                fill="none"
                                                stroke-width="3.5"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                :stroke="pairIsUpward(pair) ? '#16a34a' : '#dc2626'"
                                            ></path>
                                        </svg>
                                    </div>
                                </template>

                                <template x-if="pairHistoryRates(pair).length < 2">
                                    <div class="rounded-2xl border border-dashed border-stone-300 bg-white/80 px-4 py-5 text-sm text-text-muted">
                                        Not enough historical data for chart yet.
                                    </div>
                                </template>
                            </div>
                        </template>
                    </div>
                </template>

                <template x-if="!trackedPairs.length">
                    <div class="rounded-[2rem] border border-dashed border-stone-300 bg-stone-50/70 px-6 py-8 text-center text-text-muted">
                        No tracked pairs yet. Add one from the selectors above.
                    </div>
                </template>
            </div>

        </div>
    </div>

    <div class="bg-primary/5 rounded-3xl p-6 flex gap-4 border border-primary/10">
        <span class="material-symbols-outlined text-primary">info</span>
        <div class="text-sm text-text-muted leading-relaxed">
            Rates are throttled to one refresh per minute to avoid excessive API usage. Your tracked pairs and cached rate history are saved in your browser.
        </div>
    </div>

    <div class="flex justify-center">
        <a href="/tools/" class="flex items-center gap-2 text-text-muted hover:text-primary transition-colors font-bold uppercase tracking-widest text-xs">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Back to Tools
        </a>
    </div>
</div>

<script>
    function currencyRatesTool() {
        return {
            storageKey: 'currency-rates-tool-state-v2',
            minRefetchMs: 60 * 1000,
            isLoading: false,
            isCurrenciesLoading: false,
            now: Date.now(),
            timer: null,
            lastFetchedAt: null,
            errorMessage: '',

            availableCurrencies: {},
            trackedPairs: [
                { base: 'USD', target: 'IDR' },
                { base: 'USD', target: 'SAR' },
                { base: 'USD', target: 'CNY' },
                { base: 'USD', target: 'SGD' }
            ],
            pairFormBase: 'USD',
            pairFormTarget: 'IDR',
            pairRates: {},
            _rateFormatter: null,

            init() {
                this.loadState();
                this.timer = window.setInterval(() => {
                    this.now = Date.now();
                }, 1000);
                this.loadAvailableCurrencies();
                if (this.canRefetch()) {
                    this.fetchAllPairRates();
                }
            },

            destroy() {
                if (this.timer) {
                    window.clearInterval(this.timer);
                    this.timer = null;
                }
            },

            async loadAvailableCurrencies() {
                this.isCurrenciesLoading = true;
                try {
                    const response = await fetch('https://api.frankfurter.dev/v2/currencies');
                    if (response.ok) {
                        const data = await response.json();
                        // v2 API returns an array of {iso_code, name, ...} objects
                        if (Array.isArray(data)) {
                            this.availableCurrencies = Object.fromEntries(data.map(item => [item.iso_code, item.name]));
                        } else {
                            this.availableCurrencies = data;
                        }
                        this.normalizeTrackedPairs();
                        this.normalizePairForm();
                    }
                } catch (error) {
                    console.warn('Failed to load available currencies.', error);
                } finally {
                    this.isCurrenciesLoading = false;
                }
            },

            allCurrencies() {
                return Object.entries(this.availableCurrencies)
                    .map(([code, name]) => ({ code, name }))
                    .sort((a, b) => a.code.localeCompare(b.code));
            },

            pairKey(base, target) {
                return `${base}__${target}`;
            },

            normalizeTrackedPairs() {
                const validCodes = new Set(Object.keys(this.availableCurrencies));
                const unique = new Set();
                this.trackedPairs = this.trackedPairs
                    .filter(pair => pair && typeof pair.base === 'string' && typeof pair.target === 'string')
                    .map(pair => ({ base: pair.base, target: pair.target }))
                    .filter(pair => pair.base !== pair.target)
                    .filter(pair => validCodes.size === 0 || (validCodes.has(pair.base) && validCodes.has(pair.target)))
                    .filter(pair => {
                        const key = this.pairKey(pair.base, pair.target);
                        if (unique.has(key)) {
                            return false;
                        }
                        unique.add(key);
                        return true;
                    });
            },

            normalizePairForm() {
                const codes = this.allCurrencies().map(c => c.code);
                if (!codes.length) {
                    return;
                }

                if (!codes.includes(this.pairFormBase)) {
                    this.pairFormBase = codes[0];
                }
                if (!codes.includes(this.pairFormTarget) || this.pairFormTarget === this.pairFormBase) {
                    const fallbackTarget = codes.find(code => code !== this.pairFormBase);
                    this.pairFormTarget = fallbackTarget || this.pairFormBase;
                }
            },

            loadState() {
                try {
                    const saved = localStorage.getItem(this.storageKey);
                    if (!saved) {
                        return;
                    }
                    const parsed = JSON.parse(saved);
                    if (Array.isArray(parsed.trackedPairs)) {
                        this.trackedPairs = parsed.trackedPairs;
                    } else if (Array.isArray(parsed.trackedCurrencies)) {
                        const legacyBase = typeof parsed.baseCurrency === 'string' ? parsed.baseCurrency : 'USD';
                        this.trackedPairs = parsed.trackedCurrencies
                            .filter(c => typeof c === 'string' && c.length > 0)
                            .map(target => ({ base: legacyBase, target }));
                    }
                    if (typeof parsed.pairFormBase === 'string') {
                        this.pairFormBase = parsed.pairFormBase;
                    }
                    if (typeof parsed.pairFormTarget === 'string') {
                        this.pairFormTarget = parsed.pairFormTarget;
                    }
                    if (parsed.pairRates && typeof parsed.pairRates === 'object' && !Array.isArray(parsed.pairRates)) {
                        this.pairRates = parsed.pairRates;
                    }
                    if (typeof parsed.lastFetchedAt === 'number') {
                        this.lastFetchedAt = parsed.lastFetchedAt;
                    }
                    this.normalizeTrackedPairs();
                } catch (error) {
                    console.warn('Failed to restore currency rates state from localStorage.', error);
                }
            },

            saveState() {
                localStorage.setItem(this.storageKey, JSON.stringify({
                    trackedPairs: this.trackedPairs,
                    pairFormBase: this.pairFormBase,
                    pairFormTarget: this.pairFormTarget,
                    pairRates: this.pairRates,
                    lastFetchedAt: this.lastFetchedAt
                }));
            },

            canRefetch() {
                if (!this.lastFetchedAt) {
                    return true;
                }
                return (this.now - this.lastFetchedAt) >= this.minRefetchMs;
            },

            remainingRefetchSeconds() {
                if (this.canRefetch()) {
                    return 0;
                }
                const remaining = this.minRefetchMs - (this.now - this.lastFetchedAt);
                return Math.max(1, Math.ceil(remaining / 1000));
            },

            async refetchRates() {
                if (this.isLoading || !this.canRefetch()) {
                    return;
                }
                await this.fetchAllPairRates();
            },

            onPairFormBaseChange() {
                if (this.pairFormBase === this.pairFormTarget) {
                    const fallback = this.allCurrencies().find(currency => currency.code !== this.pairFormBase);
                    this.pairFormTarget = fallback ? fallback.code : this.pairFormBase;
                }
                this.saveState();
            },

            canAddPair() {
                if (!this.pairFormBase || !this.pairFormTarget) {
                    return false;
                }
                if (this.pairFormBase === this.pairFormTarget) {
                    return false;
                }
                return !this.trackedPairs.some(
                    pair => pair.base === this.pairFormBase && pair.target === this.pairFormTarget
                );
            },

            async fetchPairRates(base, target) {
                const endDate = new Date();
                const startDate = new Date(endDate);
                startDate.setDate(endDate.getDate() - 13);
                const start = startDate.toISOString().slice(0, 10);
                const end = endDate.toISOString().slice(0, 10);
                const url = `https://api.frankfurter.dev/v2/rates?base=${encodeURIComponent(base)}&quote=${encodeURIComponent(target)}&start=${start}&end=${end}`;
                const response = await fetch(url);
                if (!response.ok) {
                    throw new Error(`API returned ${response.status}`);
                }
                const payload = await response.json();

                let points = [];
                if (Array.isArray(payload)) {
                    points = payload
                        .filter(item => item && item.quote === target && typeof item.rate === 'number' && item.date)
                        .map(item => ({ date: item.date, rate: item.rate }));
                } else if (payload && typeof payload === 'object' && payload.rates && typeof payload.rates === 'object') {
                    points = Object.entries(payload.rates)
                        .map(([date, value]) => ({
                            date,
                            rate: typeof value === 'number' ? value : (value && typeof value[target] === 'number' ? value[target] : null)
                        }))
                        .filter(item => typeof item.rate === 'number');
                }

                points.sort((a, b) => a.date.localeCompare(b.date));
                const latest = points.length ? points[points.length - 1].rate : null;
                return { latest, points };
            },

            async fetchAllPairRates(bypassCooldown = false) {
                if (this.isLoading) {
                    return;
                }
                if (!bypassCooldown && !this.canRefetch()) {
                    return;
                }

                this.isLoading = true;
                this.errorMessage = '';
                const fetchedAt = Date.now();

                try {
                    const entries = await Promise.all(
                        this.trackedPairs.map(async pair => {
                            const result = await this.fetchPairRates(pair.base, pair.target);
                            return [this.pairKey(pair.base, pair.target), result];
                        })
                    );
                    this.pairRates = Object.fromEntries(entries);
                    this.lastFetchedAt = fetchedAt;
                    this.saveState();
                } catch (error) {
                    this.errorMessage = 'Unable to fetch exchange rates right now. Please try again.';
                } finally {
                    this.isLoading = false;
                }
            },

            addTrackedPair() {
                if (!this.canAddPair()) {
                    return;
                }
                const newPair = {
                    base: this.pairFormBase,
                    target: this.pairFormTarget
                };
                this.trackedPairs = [...this.trackedPairs, newPair];
                this.saveState();
                this.fetchAllPairRates(true);
            },

            removeTrackedPair(pairToRemove) {
                const pairId = this.pairKey(pairToRemove.base, pairToRemove.target);
                this.trackedPairs = this.trackedPairs.filter(
                    pair => this.pairKey(pair.base, pair.target) !== pairId
                );
                const { [pairId]: _removed, ...remainingRates } = this.pairRates;
                this.pairRates = remainingRates;
                this.saveState();
            },

            lastFetchedLabel() {
                if (!this.lastFetchedAt) {
                    return 'Latest fetch: Not available yet';
                }
                const formatted = new Intl.DateTimeFormat(undefined, {
                    weekday: 'short',
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit'
                }).format(this.lastFetchedAt);
                return `Latest fetch: ${formatted}`;
            },

            hasPairLatestRate(pair) {
                const key = this.pairKey(pair.base, pair.target);
                return typeof this.pairRates[key]?.latest === 'number';
            },

            pairLatestRate(pair) {
                const key = this.pairKey(pair.base, pair.target);
                return this.pairRates[key]?.latest;
            },

            pairHistoryRates(pair) {
                const key = this.pairKey(pair.base, pair.target);
                return Array.isArray(this.pairRates[key]?.points) ? this.pairRates[key].points : [];
            },

            pairIsUpward(pair) {
                const history = this.pairHistoryRates(pair);
                if (history.length < 2) {
                    return false;
                }
                return history[history.length - 1].rate > history[0].rate;
            },

            pairChartPath(pair) {
                const history = this.pairHistoryRates(pair);
                if (history.length < 2) {
                    return '';
                }
                const width = 320;
                const height = 100;
                const padding = 8;
                const rates = history.map(item => item.rate);
                const minRate = Math.min(...rates);
                const maxRate = Math.max(...rates);
                const range = maxRate - minRate || 1;
                const stepX = (width - padding * 2) / (history.length - 1);
                const points = history.map((item, index) => {
                    const normalized = (item.rate - minRate) / range;
                    return {
                        x: padding + index * stepX,
                        y: (height - padding) - normalized * (height - padding * 2)
                    };
                });

                if (points.length === 2) {
                    return `M ${points[0].x} ${points[0].y} L ${points[1].x} ${points[1].y}`;
                }

                let path = `M ${points[0].x} ${points[0].y}`;
                for (let i = 1; i < points.length - 1; i += 1) {
                    const current = points[i];
                    const next = points[i + 1];
                    const midpointX = (current.x + next.x) / 2;
                    const midpointY = (current.y + next.y) / 2;
                    path += ` Q ${current.x} ${current.y} ${midpointX} ${midpointY}`;
                }
                const last = points[points.length - 1];
                path += ` T ${last.x} ${last.y}`;
                return path;
            },

            formatRate(value) {
                if (typeof value !== 'number' || !isFinite(value)) {
                    return '—';
                }
                if (!this._rateFormatter) {
                    this._rateFormatter = new Intl.NumberFormat(undefined, {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 6
                    });
                }
                return this._rateFormatter.format(value);
            }
        };
    }
</script>
