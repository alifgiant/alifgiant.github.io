---
layout: layouts/base.njk
title: Currency Rates Tracker
description: Track and compare currency exchange rates with a customizable base currency and amount.
permalink: /tools/currency-rates/
---

<div class="w-full max-w-5xl flex flex-col gap-12" x-data="currencyRatesTool()" x-init="init()">
    {% set tool = {} %}
    {% for item in site.pages.tools.list %}
        {% if item.url == "/tools/currency-rates/" %}
            {% set tool = item %}
        {% endif %}
    {% endfor %}
    {% set cat = site.pages.tools.categories[tool.tag] %}

    <div class="flex flex-col gap-4 text-center items-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border {{ cat.color }}">
            <span class="material-symbols-outlined text-sm">{{ cat.icon }}</span>
            {{ tool.tag }}
        </div>
        <div class="w-16 h-16 rounded-2xl {{ cat.lightColor }} flex items-center justify-center mb-2">
            <span class="material-symbols-outlined text-4xl">{{ tool.icon }}</span>
        </div>
        <h1 class="text-4xl md:text-6xl font-bold text-text-main font-display">
            {{ tool.title }}
        </h1>
        <p class="text-lg text-text-muted max-w-2xl leading-relaxed">
            {{ tool.description }}
        </p>
    </div>

    <div class="bg-white/80 backdrop-blur-md border border-white rounded-[2.5rem] p-8 md:p-12 shadow-2xl shadow-primary/10 transition-all duration-500">
        <div class="flex flex-col gap-8">

            <!-- Source info + Refetch button -->
            <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                <div class="flex flex-col gap-1 text-sm text-text-muted">
                    <div class="font-semibold text-text-main">Source: Frankfurter API</div>
                    <div x-text="lastFetchedLabel()"></div>
                </div>
                <button
                    @click="refetchRates()"
                    :disabled="isLoading || !canRefetch()"
                    class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-2xl bg-primary text-white font-bold hover:bg-primary-dark disabled:opacity-50 disabled:cursor-not-allowed transition-colors shadow-lg shadow-primary/20"
                >
                    <span class="material-symbols-outlined text-base" x-text="isLoading ? 'progress_activity' : 'refresh'"></span>
                    <span x-text="isLoading ? 'Fetching...' : 'Refetch rates'"></span>
                </button>
            </div>

            <template x-if="!canRefetch() && !isLoading">
                <div class="rounded-2xl border border-amber-200 bg-amber-50 text-amber-800 px-4 py-3 text-sm">
                    You can refetch in <span class="font-semibold tabular-nums" x-text="remainingRefetchSeconds()"></span>s.
                </div>
            </template>

            <template x-if="errorMessage">
                <div class="rounded-2xl border border-rose-200 bg-rose-50 text-rose-700 px-4 py-3 text-sm" x-text="errorMessage"></div>
            </template>

            <!-- Base Currency Card -->
            <div class="rounded-[2rem] bg-stone-950 text-stone-50 p-8 md:p-10 shadow-2xl relative overflow-hidden">
                <div class="absolute inset-0 bg-primary/10 pointer-events-none"></div>
                <div class="relative z-10 flex flex-col gap-6">
                    <span class="text-xs font-bold uppercase tracking-[0.3em] text-stone-400">Base Currency</span>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="flex flex-col gap-2">
                            <label class="text-xs font-bold uppercase tracking-widest text-stone-400">Currency</label>
                            <select
                                x-model="baseCurrency"
                                @change="onBaseCurrencyChange()"
                                :disabled="isCurrenciesLoading"
                                class="block w-full px-4 py-3 bg-stone-800 border border-stone-700 rounded-2xl text-stone-50 focus:outline-none focus:border-primary/50 transition-all text-base disabled:opacity-50"
                            >
                                <template x-for="currency in allCurrencies()" :key="currency.code">
                                    <option :value="currency.code" x-text="`${currency.code} – ${currency.name}`"></option>
                                </template>
                            </select>
                        </div>
                        <div class="flex flex-col gap-2">
                            <label class="text-xs font-bold uppercase tracking-widest text-stone-400">Amount</label>
                            <input
                                type="number"
                                x-model.number="baseAmount"
                                min="0"
                                step="any"
                                @change="saveState()"
                                class="block w-full px-4 py-3 bg-stone-800 border border-stone-700 rounded-2xl text-stone-50 focus:outline-none focus:border-primary/50 transition-all text-base"
                                style="font-size: 16px;"
                            >
                        </div>
                    </div>
                    <div class="flex flex-col gap-1">
                        <span class="text-4xl md:text-5xl font-bold leading-none tabular-nums" x-text="formatAmount(baseAmount) + ' ' + baseCurrency"></span>
                        <span class="text-sm text-stone-400" x-text="availableCurrencies[baseCurrency] || ''"></span>
                    </div>
                </div>
            </div>

            <div class="h-px bg-stone-100"></div>

            <!-- Tracked currencies section -->
            <div class="flex flex-col gap-5">
                <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
                    <div>
                        <h3 class="text-xl md:text-2xl font-bold text-text-main">Tracked Currencies</h3>
                        <p class="text-sm text-text-muted">Add currencies to compare. Default list is IDR, SAR, CNY, and SGD. Rates refresh with the button above.</p>
                    </div>
                    <span class="text-xs font-bold uppercase tracking-widest text-text-muted" x-text="trackedCurrencies.length + ' tracked'"></span>
                </div>

                <!-- Add currency -->
                <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_auto] gap-4 md:items-end">
                    <div class="flex flex-col gap-3">
                        <label class="text-xs font-bold uppercase tracking-widest text-text-muted ml-1">Add Currency</label>
                        <select
                            x-model="selectedCurrency"
                            :disabled="isCurrenciesLoading || addableCurrencies().length === 0"
                            class="block w-full px-6 py-4 bg-stone-50 border-2 border-stone-100 rounded-2xl text-text-main focus:outline-none focus:border-primary/30 focus:bg-white transition-all text-lg shadow-inner disabled:opacity-50"
                        >
                            <template x-for="currency in addableCurrencies()" :key="currency.code">
                                <option :value="currency.code" x-text="`${currency.code} – ${currency.name}`"></option>
                            </template>
                        </select>
                    </div>
                    <button
                        @click="addTrackedCurrency()"
                        :disabled="!selectedCurrency || isLoading"
                        class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-2xl bg-primary text-white font-bold hover:bg-primary-dark disabled:opacity-50 disabled:cursor-not-allowed transition-colors shadow-lg shadow-primary/20"
                    >
                        <span class="material-symbols-outlined text-base">add</span>
                        Add currency
                    </button>
                </div>

                <template x-if="trackedCurrencies.length">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <template x-for="code in trackedCurrencies" :key="code">
                            <div class="rounded-[2rem] border border-stone-200 bg-stone-50/80 p-6 md:p-7 shadow-sm flex flex-col gap-4">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex flex-col gap-1 min-w-0">
                                        <span class="text-xs font-bold uppercase tracking-widest text-text-muted">Currency</span>
                                        <h3 class="text-2xl font-bold text-text-main leading-tight" x-text="code"></h3>
                                        <span class="text-sm text-text-muted" x-text="availableCurrencies[code] || ''"></span>
                                    </div>
                                    <button
                                        @click="removeTrackedCurrency(code)"
                                        class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-white text-text-muted hover:text-rose-600 hover:bg-rose-50 border border-stone-200 transition-colors flex-shrink-0"
                                        aria-label="Remove tracked currency"
                                    >
                                        <span class="material-symbols-outlined text-base">delete</span>
                                    </button>
                                </div>

                                <template x-if="typeof rates[code] === 'number'">
                                    <div class="flex flex-col gap-1">
                                        <span class="text-4xl font-bold text-text-main leading-none tabular-nums" x-text="formatAmount(baseAmount * rates[code]) + ' ' + code"></span>
                                        <span class="text-sm text-text-muted" x-text="`1 ${baseCurrency} = ${formatRate(rates[code])} ${code}`"></span>
                                    </div>
                                </template>

                                <template x-if="typeof rates[code] !== 'number'">
                                    <div class="rounded-2xl border border-dashed border-stone-300 bg-white/80 px-4 py-5 text-sm text-text-muted">
                                        Rate unavailable. Use Refetch to load.
                                    </div>
                                </template>
                            </div>
                        </template>
                    </div>
                </template>

                <template x-if="!trackedCurrencies.length">
                    <div class="rounded-[2rem] border border-dashed border-stone-300 bg-stone-50/70 px-6 py-8 text-center text-text-muted">
                        No tracked currencies yet. Add one from the selector above.
                    </div>
                </template>
            </div>

        </div>
    </div>

    <div class="bg-primary/5 rounded-3xl p-6 flex gap-4 border border-primary/10">
        <span class="material-symbols-outlined text-primary">info</span>
        <div class="text-sm text-text-muted leading-relaxed">
            Rates are throttled to one refresh per minute to avoid excessive API usage. Your base currency, amount, tracked currencies, and cached rates are saved in your browser.
        </div>
    </div>

    <div class="flex justify-center">
        <a href="/tools/" class="flex items-center gap-2 text-text-muted hover:text-primary transition-colors font-bold uppercase tracking-widest text-xs">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Back to Tools
        </a>
    </div>
</div>

<script>
    function currencyRatesTool() {
        return {
            storageKey: 'currency-rates-tool-state-v2',
            minRefetchMs: 60 * 1000,
            isLoading: false,
            isCurrenciesLoading: false,
            now: Date.now(),
            timer: null,
            lastFetchedAt: null,
            errorMessage: '',

            availableCurrencies: {},
            baseCurrency: 'USD',
            baseAmount: 1,
            trackedCurrencies: ['IDR', 'SAR', 'CNY', 'SGD'],
            selectedCurrency: '',
            rates: {},
            _amountFormatter: null,
            _rateFormatter: null,

            init() {
                this.loadState();
                this.timer = window.setInterval(() => {
                    this.now = Date.now();
                }, 1000);
                this.loadAvailableCurrencies();
                if (this.canRefetch()) {
                    this.fetchRates();
                }
            },

            destroy() {
                if (this.timer) {
                    window.clearInterval(this.timer);
                    this.timer = null;
                }
            },

            async loadAvailableCurrencies() {
                this.isCurrenciesLoading = true;
                try {
                    const response = await fetch('https://api.frankfurter.dev/v2/currencies');
                    if (response.ok) {
                        this.availableCurrencies = await response.json();
                        this.updateSelectedCurrency();
                    }
                } catch (error) {
                    console.warn('Failed to load available currencies.', error);
                } finally {
                    this.isCurrenciesLoading = false;
                }
            },

            allCurrencies() {
                return Object.entries(this.availableCurrencies).map(([code, name]) => ({ code, name }));
            },

            addableCurrencies() {
                return Object.entries(this.availableCurrencies)
                    .filter(([code]) => code !== this.baseCurrency && !this.trackedCurrencies.includes(code))
                    .map(([code, name]) => ({ code, name }));
            },

            updateSelectedCurrency() {
                const addable = this.addableCurrencies();
                const stillAddable = addable.find(c => c.code === this.selectedCurrency);
                if (!stillAddable) {
                    this.selectedCurrency = addable.length > 0 ? addable[0].code : '';
                }
            },

            loadState() {
                try {
                    const saved = localStorage.getItem(this.storageKey);
                    if (!saved) {
                        return;
                    }
                    const parsed = JSON.parse(saved);
                    if (typeof parsed.baseCurrency === 'string') {
                        this.baseCurrency = parsed.baseCurrency;
                    }
                    if (typeof parsed.baseAmount === 'number' && parsed.baseAmount >= 0) {
                        this.baseAmount = parsed.baseAmount;
                    }
                    if (Array.isArray(parsed.trackedCurrencies)) {
                        this.trackedCurrencies = parsed.trackedCurrencies.filter(c => typeof c === 'string' && c.length > 0);
                    }
                    if (parsed.rates && typeof parsed.rates === 'object' && !Array.isArray(parsed.rates)) {
                        this.rates = parsed.rates;
                    }
                    if (typeof parsed.lastFetchedAt === 'number') {
                        this.lastFetchedAt = parsed.lastFetchedAt;
                    }
                } catch (error) {
                    console.warn('Failed to restore currency rates state from localStorage.', error);
                }
            },

            saveState() {
                localStorage.setItem(this.storageKey, JSON.stringify({
                    baseCurrency: this.baseCurrency,
                    baseAmount: this.baseAmount,
                    trackedCurrencies: this.trackedCurrencies,
                    rates: this.rates,
                    lastFetchedAt: this.lastFetchedAt
                }));
            },

            canRefetch() {
                if (!this.lastFetchedAt) {
                    return true;
                }
                return (this.now - this.lastFetchedAt) >= this.minRefetchMs;
            },

            remainingRefetchSeconds() {
                if (this.canRefetch()) {
                    return 0;
                }
                const remaining = this.minRefetchMs - (this.now - this.lastFetchedAt);
                return Math.max(1, Math.ceil(remaining / 1000));
            },

            async refetchRates() {
                if (this.isLoading || !this.canRefetch()) {
                    return;
                }
                await this.fetchRates();
            },

            async onBaseCurrencyChange() {
                // Remove the new base currency from tracked list if it was there
                this.trackedCurrencies = this.trackedCurrencies.filter(c => c !== this.baseCurrency);
                this.rates = {};
                this.updateSelectedCurrency();
                // Fetch fresh rates for the new base; bypasses the cooldown since the base changed
                await this.fetchRates(true);
            },

            async fetchRates(bypassCooldown = false) {
                if (this.isLoading) {
                    return;
                }
                if (!bypassCooldown && !this.canRefetch()) {
                    return;
                }

                this.isLoading = true;
                this.errorMessage = '';
                const fetchedAt = Date.now();

                try {
                    const response = await fetch(
                        `https://api.frankfurter.dev/v2/rates?base=${encodeURIComponent(this.baseCurrency)}`
                    );
                    if (!response.ok) {
                        throw new Error(`API returned ${response.status}`);
                    }
                    const payload = await response.json();
                    this.rates = (payload && typeof payload.rates === 'object') ? payload.rates : {};
                    this.lastFetchedAt = fetchedAt;
                    this.saveState();
                } catch (error) {
                    this.errorMessage = 'Unable to fetch exchange rates right now. Please try again.';
                } finally {
                    this.isLoading = false;
                }
            },

            addTrackedCurrency() {
                if (!this.selectedCurrency || this.trackedCurrencies.includes(this.selectedCurrency)) {
                    return;
                }
                this.trackedCurrencies = [...this.trackedCurrencies, this.selectedCurrency];
                this.updateSelectedCurrency();
                this.saveState();
            },

            removeTrackedCurrency(code) {
                this.trackedCurrencies = this.trackedCurrencies.filter(c => c !== code);
                this.updateSelectedCurrency();
                this.saveState();
            },

            lastFetchedLabel() {
                if (!this.lastFetchedAt) {
                    return 'Latest fetch: Not available yet';
                }
                const formatted = new Intl.DateTimeFormat(undefined, {
                    weekday: 'short',
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit'
                }).format(this.lastFetchedAt);
                return `Latest fetch: ${formatted}`;
            },

            formatAmount(value) {
                if (typeof value !== 'number' || !isFinite(value)) {
                    return '—';
                }
                if (!this._amountFormatter) {
                    this._amountFormatter = new Intl.NumberFormat(undefined, {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                }
                return this._amountFormatter.format(value);
            },

            formatRate(value) {
                if (typeof value !== 'number' || !isFinite(value)) {
                    return '—';
                }
                if (!this._rateFormatter) {
                    this._rateFormatter = new Intl.NumberFormat(undefined, {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 6
                    });
                }
                return this._rateFormatter.format(value);
            }
        };
    }
</script>
