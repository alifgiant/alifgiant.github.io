---
layout: layouts/base.njk
title: Currency Rates Tracker
description: Track selected currency exchange rates against IDR with one-click refresh.
permalink: /tools/currency-rates/
---

<div class="w-full max-w-5xl flex flex-col gap-12" x-data="currencyRatesTool()" x-init="init()">
    {% set tool = {} %}
    {% for item in site.pages.tools.list %}
        {% if item.url == "/tools/currency-rates/" %}
            {% set tool = item %}
        {% endif %}
    {% endfor %}
    {% set cat = site.pages.tools.categories[tool.tag] %}

    <div class="flex flex-col gap-4 text-center items-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border {{ cat.color }}">
            <span class="material-symbols-outlined text-sm">{{ cat.icon }}</span>
            {{ tool.tag }}
        </div>
        <div class="w-16 h-16 rounded-2xl {{ cat.lightColor }} flex items-center justify-center mb-2">
            <span class="material-symbols-outlined text-4xl">{{ tool.icon }}</span>
        </div>
        <h1 class="text-4xl md:text-6xl font-bold text-text-main font-display">
            {{ tool.title }}
        </h1>
        <p class="text-lg text-text-muted max-w-2xl leading-relaxed">
            {{ tool.description }}
        </p>
    </div>

    <div class="bg-white/80 backdrop-blur-md border border-white rounded-[2.5rem] p-8 md:p-12 shadow-2xl shadow-primary/10 transition-all duration-500">
        <div class="flex flex-col gap-8">
            <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                <div class="flex flex-col gap-1 text-sm text-text-muted">
                    <div class="font-semibold text-text-main">Source: Frankfurter API</div>
                    <div x-text="lastFetchedLabel()"></div>
                </div>
                <button
                    @click="refetchRates()"
                    :disabled="isLoading || !canRefetch()"
                    class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-2xl bg-primary text-white font-bold hover:bg-primary-dark disabled:opacity-50 disabled:cursor-not-allowed transition-colors shadow-lg shadow-primary/20"
                >
                    <span class="material-symbols-outlined text-base" x-text="isLoading ? 'progress_activity' : 'refresh'"></span>
                    <span x-text="isLoading ? 'Fetching...' : 'Refetch rates'"></span>
                </button>
            </div>

            <template x-if="!canRefetch() && !isLoading">
                <div class="rounded-2xl border border-amber-200 bg-amber-50 text-amber-800 px-4 py-3 text-sm">
                    You can refetch in <span class="font-semibold tabular-nums" x-text="remainingRefetchSeconds()"></span>s.
                </div>
            </template>

            <template x-if="errorMessage">
                <div class="rounded-2xl border border-rose-200 bg-rose-50 text-rose-700 px-4 py-3 text-sm" x-text="errorMessage"></div>
            </template>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <template x-for="pair in trackedPairs" :key="pair.id">
                    <div class="rounded-[2rem] border border-stone-200 bg-stone-50/80 p-6 md:p-7 shadow-sm flex flex-col gap-4">
                        <div class="flex items-center justify-between gap-3">
                            <div class="flex flex-col gap-1">
                                <span class="text-xs font-bold uppercase tracking-widest text-text-muted">Currency Pair</span>
                                <h3 class="text-2xl font-bold text-text-main leading-tight" x-text="pair.id"></h3>
                            </div>
                            <span class="material-symbols-outlined text-text-muted">payments</span>
                        </div>

                        <template x-if="typeof pair.rate === 'number'">
                            <div class="flex flex-col gap-1">
                                <span class="text-4xl font-bold text-text-main leading-none tabular-nums" x-text="formatRate(pair.rate)"></span>
                                <span class="text-sm text-text-muted" x-text="`1 ${pair.displayBase} = ${formatRate(pair.rate)} ${pair.quote}`"></span>
                            </div>
                        </template>

                        <template x-if="typeof pair.rate !== 'number'">
                            <div class="rounded-2xl border border-dashed border-stone-300 bg-white/80 px-4 py-5 text-sm text-text-muted">
                                Rate unavailable.
                            </div>
                        </template>

                        <template x-if="pair.error">
                            <div class="rounded-2xl border border-rose-200 bg-rose-50 text-rose-700 px-4 py-3 text-xs" x-text="pair.error"></div>
                        </template>
                    </div>
                </template>
            </div>
        </div>
    </div>

    <div class="bg-primary/5 rounded-3xl p-6 flex gap-4 border border-primary/10">
        <span class="material-symbols-outlined text-primary">info</span>
        <div class="text-sm text-text-muted leading-relaxed">
            Refetch requests are throttled for one minute after each fetch attempt.
        </div>
    </div>

    <div class="flex justify-center">
        <a href="/tools/" class="flex items-center gap-2 text-text-muted hover:text-primary transition-colors font-bold uppercase tracking-widest text-xs">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Back to Tools
        </a>
    </div>
</div>

<script>
    function currencyRatesTool() {
        return {
            storageKey: 'currency-rates-tool-state-v1',
            minRefetchMs: 60 * 1000,
            isLoading: false,
            now: Date.now(),
            timer: null,
            lastFetchedAt: null,
            errorMessage: '',
            trackedPairs: [
                { id: 'USD/IDR', base: 'USD', displayBase: 'USD', quote: 'IDR', rate: null, error: '' },
                { id: 'SAR/IDR', base: 'SAR', displayBase: 'SAR', quote: 'IDR', rate: null, error: '' },
                // Keep CYN label in UI per product requirement while querying CNY from API.
                { id: 'CYN/IDR', base: 'CNY', displayBase: 'CYN', quote: 'IDR', rate: null, error: '' },
                { id: 'SGD/IDR', base: 'SGD', displayBase: 'SGD', quote: 'IDR', rate: null, error: '' }
            ],

            init() {
                this.loadState();
                this.timer = window.setInterval(() => {
                    this.now = Date.now();
                }, 1000);
                this.fetchRates();
            },

            loadState() {
                try {
                    const saved = localStorage.getItem(this.storageKey);
                    if (!saved) {
                        return;
                    }

                    const parsed = JSON.parse(saved);
                    if (Array.isArray(parsed.trackedPairs)) {
                        this.trackedPairs = this.trackedPairs.map(defaultPair => {
                            const savedPair = parsed.trackedPairs.find(item => item.id === defaultPair.id);
                            if (!savedPair || typeof savedPair !== 'object') {
                                return defaultPair;
                            }
                            // Keep canonical base/display mapping from defaults; only restore dynamic fetch state.
                            return {
                                ...defaultPair,
                                rate: typeof savedPair.rate === 'number' ? savedPair.rate : null,
                                error: typeof savedPair.error === 'string' ? savedPair.error : ''
                            };
                        });
                    }

                    if (typeof parsed.lastFetchedAt === 'number') {
                        this.lastFetchedAt = parsed.lastFetchedAt;
                    }
                } catch (error) {
                    console.warn('Failed to restore currency rates state from localStorage.', error);
                    this.lastFetchedAt = null;
                }
            },

            saveState() {
                localStorage.setItem(this.storageKey, JSON.stringify({
                    trackedPairs: this.trackedPairs,
                    lastFetchedAt: this.lastFetchedAt
                }));
            },

            canRefetch() {
                if (!this.lastFetchedAt) {
                    return true;
                }
                return (this.now - this.lastFetchedAt) >= this.minRefetchMs;
            },

            remainingRefetchSeconds() {
                if (this.canRefetch()) {
                    return 0;
                }
                const remaining = this.minRefetchMs - (this.now - this.lastFetchedAt);
                return Math.max(1, Math.ceil(remaining / 1000));
            },

            async refetchRates() {
                if (this.isLoading || !this.canRefetch()) {
                    return;
                }
                await this.fetchRates();
            },

            async fetchRates() {
                this.isLoading = true;
                this.errorMessage = '';
                this.now = Date.now();
                const fetchedAt = Date.now();

                try {
                    const nextPairs = await Promise.all(this.trackedPairs.map(async pair => {
                        try {
                            const requestBase = pair.base;
                            const quote = pair.quote;
                            if (!requestBase || !quote) {
                                throw new Error(`Invalid currency pair: ${pair.id}`);
                            }
                            const response = await fetch(`https://api.frankfurter.dev/v2/rates?base=${encodeURIComponent(requestBase)}&symbols=${encodeURIComponent(quote)}`);
                            if (!response.ok) {
                                throw new Error(`API returned ${response.status}`);
                            }

                            const payload = await response.json();
                            const rate = payload?.rates?.[pair.quote];
                            if (typeof rate !== 'number') {
                                throw new Error(`Rate not found for ${pair.id}`);
                            }

                            return { ...pair, rate, error: '' };
                        } catch (error) {
                            const message = error instanceof Error ? error.message : `Unable to fetch ${pair.id}.`;
                            return { ...pair, rate: null, error: message };
                        }
                    }));

                    this.trackedPairs = nextPairs;
                    this.lastFetchedAt = fetchedAt;
                    this.saveState();
                } catch (error) {
                    this.errorMessage = 'Unable to fetch exchange rates right now. Please try again.';
                } finally {
                    this.isLoading = false;
                }
            },

            lastFetchedLabel() {
                if (!this.lastFetchedAt) {
                    return 'Latest fetch: Not available yet';
                }
                const formatted = new Intl.DateTimeFormat(undefined, {
                    weekday: 'short',
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit'
                }).format(this.lastFetchedAt);
                return `Latest fetch: ${formatted}`;
            },

            formatRate(value) {
                return new Intl.NumberFormat(undefined, {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }).format(value);
            }
        };
    }
</script>
